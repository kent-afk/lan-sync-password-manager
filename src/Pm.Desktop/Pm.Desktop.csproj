<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pm-desktop</AssemblyName>
    <RootNamespace>Pm.Desktop</RootNamespace>
    <ApplicationIcon>Assets/pm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/pm.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pm.App/Pm.App.csproj" />
    <ProjectReference Include="../Pm.Cli/Pm.Cli.csproj" />
    <ProjectReference Include="../Pm.Core/Pm.Core.csproj" />
    <ProjectReference Include="../Pm.Net/Pm.Net.csproj" />
    <ProjectReference Include="../Pm.Secrets/Pm.Secrets.csproj" />
    <ProjectReference Include="../Pm.Sync/Pm.Sync.csproj" />
  </ItemGroup>

</Project>
